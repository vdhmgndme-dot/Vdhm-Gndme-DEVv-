{
  "name": "abdullah-al-mohit-portfolio-desktop",
  "version": "1.0.0",
  "description": "Abdullah Al Mohit - Developer Portfolio Windows Desktop Application",
  "main": "main.js",
  "author": "Abdullah Al Mohit <mouhithgaming@gmail.com>",
  "license": "MIT",
  "scripts": {
    "start": "electron main.js",
    "build:win": "electron-builder --win nsis portable --x64 --publish never"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vdhmgndme-dot/Vdhm-Gndme-DEVv-.git"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.abdullahalmohit.desktop",
    "productName": "Abdullah Al Mohit Developer Portfolio",
    "directories": {
      "output": "../dist_electron"
    },
    "files": [
      "main.js",
      "../dist/**/*"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
